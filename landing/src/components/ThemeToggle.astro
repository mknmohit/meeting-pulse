<details class="theme-control">
  <summary title="Choose color theme">
    <span aria-hidden="true">◐</span>
    <span data-theme-label>System</span>
  </summary>
  <div class="theme-menu" aria-label="Color theme">
    <button type="button" data-theme-choice="system" aria-pressed="true">
      System
    </button>
    <button type="button" data-theme-choice="light" aria-pressed="false">
      Light
    </button>
    <button type="button" data-theme-choice="dark" aria-pressed="false">
      Dark
    </button>
  </div>
</details>
