root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{swift,m,mm,h}]
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,mjs,cjs,astro,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sql,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
